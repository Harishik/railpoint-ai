# Python
__pycache__/
*.py[cod]
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data — large / external / generated
# The Sehwa extract is company-provided and may not be published. Only its
# checksums are committed, so anyone with access can verify their copy.
data/raw/sehwa/*
!data/raw/sehwa/SHA256SUMS
data/external/
data/synthetic/
data/processed/
legacy/dash-2024/simulation/data/*.csv

# Experiments
mlruns/
experiments/results/*.png
*.onnx
*.pt
*.ckpt
# The trained network ships, so a clone serves the real model instead of the
# fallback probe — which would itself need hours of data generation first.
!experiments/artifacts/net.pt

# Node
node_modules/
frontend/dist/

# OS / editor
.DS_Store
# GitKraken CLI downloads its installer into archive-<random>/ in the
# working directory; one 8 MB zip was committed by accident.
/archive-*/
.idea/
.vscode/

# Frontend build output
frontend/dist/
frontend/node_modules/

# Runtime db
data/*.db
logs/
